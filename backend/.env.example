# ---- App ----
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8500
CORS_ORIGINS=http://localhost:5173

# ---- Auth (user-table) ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
# Bootstrap admin created on first startup if the users table is empty
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123

# ---- Data / DuckDB ----
DUCKDB_PATH=./data/app.duckdb
# If true (or if Google creds are missing), load synthetic sample data instead of the sheet
USE_SAMPLE_DATA=true

# ---- Google Sheets ingestion (assumed until real sheet is shared) ----
GSHEET_ID=PUT_REAL_SHEET_ID_HERE
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
# Tab names in the workbook
TAB_RD26=RD26_DUMP
TAB_RD25=RD25_DUMP
TAB_FINANCE=Finance Dump
TAB_TARGETS=Targets

# ---- LLM (any OpenAI-compatible endpoint) ----
# GitHub Models. Token needs the "models" permission. gpt-4.1 is in the free tier.
LLM_BASE_URL=https://models.github.ai/inference
LLM_MODEL=openai/gpt-4.1
GITHUB_TOKEN=
# Low temperature keeps generated SQL deterministic. Remove this line for reasoning
# models (gpt-5, deepseek-r1) — they reject any value other than the default.
LLM_TEMPERATURE=0.1
LLM_JSON_MODE=true
# LLM_API_KEY is accepted as an alias for GITHUB_TOKEN.
# Alternatives — replace the three lines above:
#   Local Ollama:        http://localhost:11434/v1  + qwen2.5-coder:14b  (~9GB, fits 16GB RAM)
#   Local vLLM:          http://localhost:8000/v1   + Qwen/Qwen3-Coder-30B-A3B-Instruct
#   Hugging Face router: https://router.huggingface.co/v1 + Qwen/Qwen3-Coder-30B-A3B-Instruct
#                        (also set LLM_JSON_MODE=false — some providers ignore response_format)

# ---- Guardrails ----
GUARDRAILS_ENABLED=true

# ---- Parity-drift alerts (email + log) ----
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO=ops@example.com
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=agent@example.com
