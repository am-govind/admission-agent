# ---- App ----
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8500
CORS_ORIGINS=http://localhost:5173

# ---- Logging ----
# DEBUG | INFO | WARNING | ERROR | CRITICAL. DEBUG adds model round-trip timings and the
# memory slots in scope; INFO is the right level for normal running.
LOG_LEVEL=INFO
# text for humans, json for log aggregation in a deployed environment.
LOG_FORMAT=text
# Empty means console only. A relative path is anchored to backend/.
LOG_FILE=
# Rotation, applied only when LOG_FILE is set: 10MB per file, 5 kept.
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ---- Auth (user table lives in the SQLite app DB) ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
# Bootstrap admin, created on first startup if the users table is empty.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123

# ---- Storage ----
# Analytics only: rd26, rd25, finance_dump, targets. Rebuilt by every refresh.
DUCKDB_PATH=./data/analytics.duckdb
# Users, chat history, conversation memory, refresh audit. Survives every refresh.
APPDB_PATH=./data/app.sqlite3
# Pre-split file that used to hold both; read once to migrate users and chat history.
LEGACY_DUCKDB_PATH=./data/app.duckdb

# ---- Data source ----
# Exactly one of: gsheets | excel | sample. There is no fallback chain — if the chosen
# source fails, the refresh is recorded as failed and the last good data is kept.
#   gsheets  the live workbook (needs GSHEET_ID + credentials below)
#   excel    a local .xlsx export, for offline work
#   sample   synthetic data, for tests and demos. Never use it to answer real questions.
DATA_SOURCE=sample
EXCEL_FILE_PATH=../TRY.xlsx

# ---- Google Sheets ingestion ----
GSHEET_ID=PUT_REAL_SHEET_ID_HERE
# Service-account JSON. Share the workbook with that file's client_email (Viewer is
# enough) or reads will 404.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
# Tab names in the workbook.
TAB_RD26=RD26_DUMP
TAB_RD25=RD25_DUMP
TAB_FINANCE=Finance Dump
TAB_TARGETS=Targets
# Rows per API call. Larger windows mean fewer calls but a bigger response to buffer.
SHEETS_BATCH_ROWS=5000
SHEETS_MAX_RETRIES=3

# ---- Daily refresh ----
# Fires once per day at this local time; catch-up driven, so a restart after a missed
# window refreshes immediately rather than waiting for tomorrow.
REFRESH_AT=08:30
REFRESH_TZ=Asia/Kolkata
# How often to check whether the window has passed.
REFRESH_POLL_SECONDS=900
REFRESH_ON_STARTUP_IF_EMPTY=true

# ---- Agent ----
# Tool calls allowed per turn before the model must answer with what it has.
AGENT_MAX_TOOL_ITERATIONS=5
# Row cap for the ad-hoc explorer tool.
EXPLORER_MAX_ROWS=200
# Turns sent to the model verbatim; anything older is folded into a rolling summary.
MEMORY_VERBATIM_TURNS=10

# ---- LLM (any OpenAI-compatible endpoint) ----
# GitHub Models. The token needs the "models" permission; gpt-4.1 is in the free tier.
LLM_BASE_URL=https://models.github.ai/inference
LLM_MODEL=openai/gpt-4.1
GITHUB_TOKEN=
# LLM_API_KEY is accepted as an alias for GITHUB_TOKEN.
# Leave unset for reasoning models (gpt-5, deepseek-r1) — they reject any explicit value.
LLM_TEMPERATURE=0.1
LLM_JSON_MODE=true
# Alternatives — replace LLM_BASE_URL and LLM_MODEL above:
#   Local Ollama:        http://localhost:11434/v1  + qwen2.5-coder:14b  (~9GB, fits 16GB RAM)
#   Local vLLM:          http://localhost:8000/v1   + Qwen/Qwen3-Coder-30B-A3B-Instruct
#   Hugging Face router: https://router.huggingface.co/v1 + Qwen/Qwen3-Coder-30B-A3B-Instruct
#                        (also set LLM_JSON_MODE=false — some providers ignore response_format)

# ---- Guardrails ----
# Injection/jailbreak screening on input, PII masking on output.
GUARDRAILS_ENABLED=true

# ---- Refresh-failure alerts ----
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO=ops@example.com
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=agent@example.com
